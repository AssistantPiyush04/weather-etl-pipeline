```gitignore
# Virtual environment
venv/
.venv/

# Environment variables / secrets
.env
.env.*

# Python cache
__pycache__/
*.pyc

# Logs
logs/
*.log

# Raw and processed generated data
data/raw/
data/processed/

# Old backup folders
data/raw_old/
data/processed_old/

# IDE settings
.vscode/

# OS files
.DS_Store
Thumbs.db

